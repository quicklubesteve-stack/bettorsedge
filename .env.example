# SportsEdge AI Environment Configuration Example
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
JWT_SECRET="replace_with_secure_random_jwt_secret"
ADMIN_KEY="replace_with_admin_master_secret"

# Stripe Test Keys (Optional, non-production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Licensed Sports Data API Configuration (Leave blank until licensed provider acquired)
# Sportradar, Stats Perform, or Pro Football Focus (PFF)
NFL_DATA_API_KEY=""
NFL_DATA_PROVIDER="" # Options: "pff", "sportradar", "mock_fixture"
NHL_DATA_API_KEY=""
NHL_DATA_PROVIDER="" # Options: "sportradar", "nhl_edge", "mock_fixture"
