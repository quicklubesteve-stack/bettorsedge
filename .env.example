# SportsEdge AI Environment Configuration Example
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
JWT_SECRET="replace_with_secure_random_jwt_secret"
ADMIN_KEY="replace_with_admin_master_secret"

# Stripe Test Keys (Optional, non-production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Official & Licensed Sports Data API Configuration
# Primary sources: official nfl.com & nhl.com public endpoints
# Licensed feeds: Sportradar, Stats Perform, or Pro Football Focus (PFF)
NFL_DATA_API_KEY=""
NFL_DATA_PROVIDER="official_nfl_feed" # Options: "official_nfl_feed", "pff", "sportradar"
NHL_DATA_API_KEY=""
NHL_DATA_PROVIDER="official_nhl_feed" # Options: "official_nhl_feed", "nhl_edge", "sportradar"
ODDS_API_KEY=""
ODDS_DATA_PROVIDER="the_odds_api" # Options: "the_odds_api", "consensus_market"

# Cloudflare Scheduled Background Worker Configuration
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
SCHEDULER_TIMEZONE="America/Toronto"
CRON_DAILY_MORNING="0 11 * * *"    # 6:00 AM EST
CRON_DAILY_MIDDAY="0 17 * * *"     # 12:00 PM EST
CRON_DAILY_EVENING="0 23 * * *"    # 6:00 PM EST
CRON_WEEKLY_FRIDAY="0 23 * * 5"    # Friday 6:00 PM EST
